# ==============================================================================
# CHESS JEENO Backend Environment Configuration
# ==============================================================================

# Server Network & Runtime Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas in Production, localhost in Development)
# Production format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chess_tournament?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/chess_tournament

# Allowed Frontend Client Origin(s) for CORS and OAuth redirects
# Production example: https://chess-jeeno.vercel.app
# Multiple origins may be comma-separated: https://app.vercel.app,https://staging.vercel.app
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret (Must be minimum 32 characters in production)
JWT_SECRET=replace_with_strong_production_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Lichess OAuth 2.0 PKCE Configuration
# Must match your OAuth application registered on https://lichess.org/account/oauth/app
LICHESS_OAUTH_CLIENT_ID=chess-jeeno
# Production example: https://your-backend.onrender.com/api/lichess/callback
LICHESS_OAUTH_REDIRECT_URI=http://localhost:5000/api/lichess/callback

# Google OAuth 2.0 OpenID Connect Configuration
# Create credentials in Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Production example: https://chess-jeeno.onrender.com/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Optional: Development Fallback Lichess Bot/API Token
LICHESS_API_TOKEN=your_optional_fallback_token_here

# Development Player Lichess Accounts & Tokens (development/testing bridge only)
LICHESS_USER_PLAYER_1=pavakka_ib
LICHESS_TOKEN_PLAYER_1=your_player_1_lichess_token_here

LICHESS_USER_PLAYER_2=indirabanus
LICHESS_TOKEN_PLAYER_2=your_player_2_lichess_token_here

LICHESS_USER_PLAYER_3=player3_lichess
LICHESS_TOKEN_PLAYER_3=your_player_3_lichess_token_here

LICHESS_USER_PLAYER_4=player4_lichess
LICHESS_TOKEN_PLAYER_4=your_player_4_lichess_token_here

