# ==============================================================================
# CHESS JEENO Frontend (Vite) Environment Configuration
# ==============================================================================

# Backend API Base URL
# Development: http://localhost:5000/api
# Production (Vercel): https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Optional: Dedicated Socket.IO Server URL (if different from VITE_API_URL origin)
# If omitted, Socket.IO automatically derives the server origin from VITE_API_URL
# Development: http://localhost:5000
# Production: https://your-backend.onrender.com
# VITE_SERVER_URL=http://localhost:5000
